%!PS
% Preview support for the restricted AI3 operators emitted by this workflow.
% Native .ai files refer to external Adobe procsets. This file implements the
% line, solid-fill, compound-path and horizontal-text subset used here.
/noopdict << /initialize {} /terminate {} >> def
/Adobe_packedarray noopdict def
/Adobe_cmykcolor noopdict def
/Adobe_cshow noopdict def
/Adobe_customcolor noopdict def
/Adobe_typography_AI3 noopdict def
/Adobe_IllustratorA_AI3 noopdict def
/annotatepage {} def
/sc [0 0 0] def /fc [0 0 0] def /compound false def
/XA {3 array astore /sc exch def} def
/Xa {3 array astore /fc exch def} def
/Lb {10 {pop} repeat} def /Ln {pop} def /LB {} def
/A {pop} def /R {pop} def /D {pop} def /i {pop} def
/J {setlinecap} def /j {setlinejoin} def /w {setlinewidth} def
/M {setmiterlimit} def /d {setdash} def
/m {moveto} def /L {lineto} def /l {lineto} def
/C {curveto} def /c {curveto} def
/S {sc aload pop setrgbcolor stroke} def
/s {closepath S} def
/F {compound not {fc aload pop setrgbcolor eofill} if} def
/f {closepath F} def
/*u {/compound true def newpath} def
/*U {/compound false def fc aload pop setrgbcolor eofill} def
/u {gsave} def /U {grestore} def
/To {pop gsave} def
/Tp {pop 6 array astore concat} def /TP {} def /Tr {pop} def
/Tf {
  /fs exch def 100 string cvs dup length 1 sub 1 exch getinterval cvn
  findfont fs scalefont setfont
} def
/Tx {fc aload pop setrgbcolor 0 0 moveto show} def
/TO {grestore} def
